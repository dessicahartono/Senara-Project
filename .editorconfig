# Pengaturan editor yang sama untuk semua anggota tim. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{php,json}]
indent_size = 4

[*.md]
# Dua spasi di akhir baris berarti baris baru di Markdown.
trim_trailing_whitespace = false
